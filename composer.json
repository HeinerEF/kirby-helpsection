{
  "name": "heineref/kirby-helpsection",
  "description": "This multilingual Kirby plugin allows Panel users to display help how to work in the Panel, which can be called up directly in the Panel by clicking on the question-mark-icon in the Panel menu on the left.",
  "type": "kirby-plugin",
  "version": "3.0.0",
  "time": "2026-10-04",
  "license": "MIT",
  "keywords": [
    "kirby5",
    "kirby-cms",
    "kirby-plugin",
    "helpsection",
    "multilingual",
    "HeinerEF"
  ],
  "authors": [
    {
      "name":     "Christian Zehetner",
      "email":    "christian@am-teich.com",
      "role":     "Developer"
    },
    {
      "name":     "HeinerEF",
      "email":    "plugins@heineref.de",
      "homepage": "https://github.com/HeinerEF",
      "role":     "Developer for the Kirby 5 migration and extension"
    }
  ],
  "support": {
    "docs":   "https://github.com/HeinerEF/kirby-helpsection/blob/main/README.md",
    "source": "https://github.com/HeinerEF/kirby-helpsection"
  },
  "require": {
    "getkirby/composer-installer": "^1.2"
  },
  "extra": {
    "installer-name": "heineref_helpsection",
    "kirby": {
      "compatible": "^5.0"
    }
  },
  "_comment": [
    "previous plugin version (K3): https://github.com/amteich/kirby-helpsection"
  ]
}
